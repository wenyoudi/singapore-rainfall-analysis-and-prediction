#!/bin/bash
#PBS -N rainfall_task1
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe

# Submit with: qsub jobs/task1_vanda.pbs
# Run qsub from the project root so PBS_O_WORKDIR points to the project.
# This job processes data and generates CSV summaries. Plotting runs locally.
set -euo pipefail

cd "${PBS_O_WORKDIR:?Submit this job from the project root}" || exit 1
test -d src && test -d data/raw
module load Spark/3.3.1-foss-2022a

# Use the module environment's Python for both driver and workers.
export PYSPARK_PYTHON="$(command -v python3)"
export PYSPARK_DRIVER_PYTHON="$PYSPARK_PYTHON"

mkdir -p outputs/environment
environment_log="outputs/environment/vanda_${PBS_JOBID:-manual}.txt"
{
    printf 'System: NUS Vanda\n'
    printf 'Job ID: %s\n' "${PBS_JOBID:-manual}"
    printf 'PBS template request: 1 node, 8 CPUs, 32 GB RAM, 02:00:00 walltime\n'
    # Site policy can adjust requests. Record scheduler values when available.
    if command -v qstat >/dev/null 2>&1 && [ -n "${PBS_JOBID:-}" ]; then
        qstat -f "$PBS_JOBID" | grep -E 'Resource_List\.(select|mem|ncpus|walltime) =' || true
    fi
    printf 'Spark execution: local[8], driver memory 24g\n'
    printf 'Python interpreter: %s\n' "$PYSPARK_PYTHON"
    date '+%Y-%m-%dT%H:%M:%S%z'
    hostname
    module list
    "$PYSPARK_PYTHON" --version
    java -version
    spark-submit --version
} > "$environment_log" 2>&1
cat "$environment_log"

# For a later rerun that only needs cleaning and EDA, keep the last three stages.
# Existing outputs are overwritten by their respective stages; raw CSVs are read only.
stages=(
    data_profiling.py
    gap_analysis.py
    cleaning_diagnostics.py
    data_cleaning.py
    cleaning_validation.py
    rainfall_eda.py
)

for stage in "${stages[@]}"; do
    printf '\nStarting %s at %s\n' "$stage" "$(date '+%Y-%m-%dT%H:%M:%S%z')"
    spark-submit \
        --master 'local[8]' \
        --driver-memory 24g \
        "src/$stage"
done

printf '\nPreprocessing and Task 1 summaries completed successfully.\n'
