#!/bin/bash
#PBS -N rainfall_interface
#PBS -l select=1:ncpus=2:mem=12gb
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
: "${PBS_JOBID:?Submit through PBS; do not run Spark on the login node}"
cd "${PBS_O_WORKDIR:?Submit from the repository root}"
# Load Python and Java only: loading Spark/3.3.1 would conflict with this venv.
module load Python/3.10.4-GCCcore-11.3.0 Java/11.0.18
export PYSPARK_PYTHON="$PWD/.venv-interface/bin/python"
export PYSPARK_DRIVER_PYTHON="$PYSPARK_PYTHON"
export SPARK_LOCAL_IP=127.0.0.1
export RAINFALL_DATA_ROOT="${RAINFALL_DATA_ROOT:-/scratch/e0969984/singapore-rainfall-analysis-and-prediction/data/processed}"
export RAINFALL_SPARK_MASTER='local[2]'
export SPARK_LOCAL_DIRS="/scratch/$(id -un)/rainfall-interface-${PBS_JOBID}"
mkdir -p "$SPARK_LOCAL_DIRS"
"$PYSPARK_PYTHON" -c 'import pyspark,streamlit; assert pyspark.__version__ == "3.5.6"; assert streamlit.__version__ == "1.56.0"'
printf 'Compute node: %s\n' "$(hostname -f)"
printf 'Forward this compute node port 8501 through Vanda, then open http://localhost:8501\n'
exec "$PYSPARK_PYTHON" -m streamlit run streamlit_app.py \
    --server.address 0.0.0.0 --server.port 8501 --server.headless true \
    --browser.gatherUsageStats false
