#!/bin/bash
#PBS -N rainfall_task2
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=04:00:00
#PBS -j oe
set -euo pipefail
: "${PBS_JOBID:?Submit through qsub; do not run on a login node}"
cd "${PBS_O_WORKDIR:?Submit from the repository root}"
module load Spark/3.3.1-foss-2022a
export PYSPARK_PYTHON="$(command -v python3)"
export PYSPARK_DRIVER_PYTHON="$PYSPARK_PYTHON"
"$PYSPARK_PYTHON" -c 'import sys; assert sys.version_info[:2] == (3, 10), sys.version'
java -version 2>&1 | grep -Eq 'version "11\.'
spark-submit --version 2>&1 | grep -Eq 'version 3\.3\.1'
module list
java -version
"$PYSPARK_PYTHON" --version
# Spill only into the user's scratch directory, on the allocated node.
task2_scratch="/scratch/$(id -un)"
export SPARK_LOCAL_DIRS="${task2_scratch}/task2/spark-tmp-${PBS_JOBID}"
mkdir -p "$SPARK_LOCAL_DIRS"
mode="${TASK2_MODE:-validation}"
if [[ "$mode" == tests ]]; then
    export SPARK_LOCAL_IP=127.0.0.1
    "$PYSPARK_PYTHON" -m pytest -q tests/test_task2_paths.py tests/test_task2_prepare.py
    exit 0
fi
args=(--input-root "${INPUT_ROOT:-/scratch/e0969984/singapore-rainfall-analysis-and-prediction/data/processed}" --threshold-mm "${THRESHOLD_MM:?Set THRESHOLD_MM in qsub -v}")
if [[ "$mode" == validation ]]; then
    args+=(--validation-station "${VALIDATION_STATION:?Set VALIDATION_STATION}" 
           --validation-year "${VALIDATION_YEAR:-2023}")
elif [[ "$mode" != full ]]; then
    echo 'TASK2_MODE must be tests, validation or full' >&2
    exit 1
fi
args+=(--output "${OUTPUT_PATH:-${task2_scratch}/task2/${mode}-${PBS_JOBID}}")
spark-submit --master 'local[8]' --driver-memory 24g src/task2_prepare.py "${args[@]}"
